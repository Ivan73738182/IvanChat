<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0E1621">

    <!-- Верхняя панель -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#17212B"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Назад" />

        <TextView
            android:id="@+id/chatAvatarText"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="💬"
            android:textSize="26sp"
            android:gravity="center"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chatTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Чат"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chatSubText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="был(а) недавно"
                android:textColor="#7F91A4"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Список сообщений -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messagesList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingVertical="6dp"
        android:clipToPadding="false" />

    <!-- Панель ввода -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#17212B"
        android:padding="8dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="#0E1621"
            android:paddingHorizontal="18dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#7F91A4"
            android:textSize="16sp"
            android:hint="Сообщение..."
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/sendBtn"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_send"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Отправить" />

    </LinearLayout>

</LinearLayout>
